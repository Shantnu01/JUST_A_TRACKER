# ==========================================
# Daymark Routine Tracker - Production Environment
# ==========================================

# Server Port (Render / Cloud hosts automatically inject PORT)
PORT=4000
NODE_ENV=production

# PostgreSQL Database Connection String
# e.g. Neon, Supabase, Render Postgres, AWS RDS
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

# JWT Authentication Secret for Study Pods & User Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_64_char_random_secret_in_production

# CORS Allowed Origin (set to your custom domain or frontend URL in production)
CLIENT_ORIGIN=https://your-tracker-domain.onrender.com

# Multi-Core CPU Clustering (Parallel Load Balancing across CPU Cores)
# WEB_CONCURRENCY: Number of worker processes to spawn (defaults to available CPU cores, capped by MAX_WORKERS)
# MAX_WORKERS: Maximum worker processes (default: 4 for RAM safety on small cloud instances)
# ENABLE_CLUSTER: Set to true to test multi-core clustering in development
WEB_CONCURRENCY=2
MAX_WORKERS=4
ENABLE_CLUSTER=true

# WebPush VAPID Notifications (Optional - generates browser habit push alarms)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com

# Upstash Redis (High-speed Ephemeral Pod Radar, Rate Limiting & Leaderboard Caching)
UPSTASH_REDIS_REST_URL=https://funny-poodle-199709.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
