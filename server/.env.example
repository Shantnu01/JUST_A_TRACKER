PORT=4000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/routine_tracker
# Set true only if your hosted PostgreSQL provider requires TLS.
PGSSL=false
# WebPush VAPID Keys (generate via: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com
